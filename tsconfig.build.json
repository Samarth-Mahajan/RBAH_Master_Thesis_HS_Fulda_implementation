{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": ".",
    "composite": true
  },
  "include": ["packages/**/*.ts", "services/**/*.ts"],
  "exclude": ["**/test/**", "dist", "node_modules"]
}
